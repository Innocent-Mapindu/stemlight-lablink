rules_version = '2';
// STEMLight LabLink security rules.
// users/{uid}                 a person's own profile and saved progress
// classes/{code}              a teacher's class (code is the join code)
//   members/{uid}             learners who joined with the code
//   assign/{id}, qsets/{id}   work the teacher sets: class members read, the teacher writes
//   subs/{uid}                a learner's submitted work: the learner and the teacher only
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isTeacher() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc().role == 'teacher'; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function upByOne(f) { return request.resource.data.get(f, 0) == resource.data.get(f, 0) || request.resource.data.get(f, 0) == resource.data.get(f, 0) + 1; }
    function textOk(f, n) { return request.resource.data[f] is string && request.resource.data[f].size() <= n; }

    match /users/{uid} {
      allow read, write: if isMe(uid);
    }

    // admins are added by hand in the Firebase console
    match /admins/{uid} {
      allow read: if isMe(uid);
    }

    // ---------- tutors: listed only after LabLink verifies them ----------
    match /tutors/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && isTeacher() && request.resource.data.verified == false;
      allow update: if isAdmin() || (isMe(uid) && request.resource.data.verified == resource.data.verified && !changed().hasAny(['verifiedAt']));
      allow delete: if isMe(uid) || isAdmin();
      match /ratings/{rid} {
        function lesson() { return get(/databases/$(database)/documents/requests/$(rid)).data; }
        allow read: if signedIn();
        // one rating per finished lesson, by that lesson's learner
        allow create: if signedIn() && lesson().learner == request.auth.uid && lesson().tutor == uid && lesson().status == 'done'
                      && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
        allow delete: if isAdmin();
      }
    }

    // ---------- lesson requests between a learner and a tutor ----------
    match /requests/{rid} {
      function party() { return signedIn() && (resource.data.learner == request.auth.uid || resource.data.tutor == request.auth.uid); }
      function asTutor() { return request.auth.uid == resource.data.tutor; }
      function asLearner() { return request.auth.uid == resource.data.learner; }
      function was() { return resource.data.status; }
      function becomes() { return request.resource.data.status; }
      // payment and payout are written only by LabLink (admin or the payment server)
      function fixed() { return !changed().hasAny(['learner', 'tutor', 'payment', 'payout', 'created', 'minor']); }
      // only the tutor sets the price, and only before it is accepted
      function offerOk() { return !changed().hasAny(['offer']) || (asTutor() && was() in ['open', 'offered']); }
      function move() {
        return becomes() == was()
          || (asTutor() && was() in ['open', 'offered'] && becomes() in ['offered', 'declined'])
          || (asLearner() && was() == 'offered' && becomes() == 'accepted')
          || (was() in ['open', 'offered', 'accepted'] && becomes() == 'cancelled')
          || (was() == 'paid' && becomes() == 'done');
      }
      allow read: if party() || isAdmin();
      allow create: if signedIn() && request.resource.data.learner == request.auth.uid && request.resource.data.status == 'open'
                    && request.resource.data.tutor != request.auth.uid
                    && get(/databases/$(database)/documents/tutors/$(request.resource.data.tutor)).data.verified == true
                    && !request.resource.data.keys().hasAny(['payment', 'payout']);
      allow update: if isAdmin() || (party() && fixed() && offerOk() && move());
      allow delete: if isAdmin();
      match /msgs/{mid} {
        function lesson() { return get(/databases/$(database)/documents/requests/$(rid)).data; }
        function inIt() { return signedIn() && (lesson().learner == request.auth.uid || lesson().tutor == request.auth.uid); }
        allow read: if inIt() || isAdmin();
        allow create: if inIt() && request.resource.data.by == request.auth.uid && textOk('text', 2000);
      }
    }

    // ---------- study groups ----------
    match /groups/{gid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.listed == true;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members.keys().hasOnly([request.auth.uid]) && textOk('name', 80);
      // the owner manages the group; anyone else may only join or leave themselves
      allow update: if isAdmin()
                    || (signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner)
                    || (signedIn() && changed().hasOnly(['members', 'names'])
                        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid])
                        && request.resource.data.members.size() <= 60);
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
      match /posts/{pid} {
        function grp() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        function member() { return signedIn() && grp().members.get(request.auth.uid, false) == true; }
        allow read: if member() || isAdmin();
        allow create: if member() && request.resource.data.author == request.auth.uid && textOk('text', 1000);
        allow delete: if isAdmin() || (signedIn() && (resource.data.author == request.auth.uid || grp().owner == request.auth.uid));
      }
    }

    // ---------- reports go only to admins ----------
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && textOk('text', 1000);
      allow read, update, delete: if isAdmin();
    }

    // ---------- FAQ that learns from questions ----------
    match /faq/{id} {
      allow get: if signedIn() && (resource.data.approved == true || isAdmin() || resource.data.by == request.auth.uid);
      allow list: if signedIn() && (resource.data.approved == true || isAdmin());
      allow create: if isAdmin() || (isTeacher() && request.resource.data.approved == false && request.resource.data.by == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /faqStats/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['views', 'helpful', 'notHelpful'])
                    && request.resource.data.get('views', 0) <= 1 && request.resource.data.get('helpful', 0) <= 1 && request.resource.data.get('notHelpful', 0) <= 1;
      allow update: if signedIn() && changed().hasOnly(['views', 'helpful', 'notHelpful']) && upByOne('views') && upByOne('helpful') && upByOne('notHelpful');
    }
    match /faqAsks/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.count == 1 && request.resource.data.answered == false && textOk('text', 300);
      allow update: if (signedIn() && changed().hasOnly(['count', 'last']) && upByOne('count'))
                    || ((isTeacher() || isAdmin()) && changed().hasOnly(['answered', 'faq']));
      allow delete: if isAdmin();
    }

    match /classes/{code} {
      function cls() { return get(/databases/$(database)/documents/classes/$(code)); }
      function owner() { return signedIn() && exists(/databases/$(database)/documents/classes/$(code)) && cls().data.owner == request.auth.uid; }
      function member() { return signedIn() && exists(/databases/$(database)/documents/classes/$(code)/members/$(request.auth.uid)); }

      allow get: if signedIn();                       // checking a join code
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if owner() && request.resource.data.owner == resource.data.owner;
      allow delete: if owner();

      match /members/{uid} {
        allow read: if owner() || isMe(uid);
        allow create, update: if isMe(uid);
        allow delete: if owner() || isMe(uid);
      }
      match /assign/{id} {
        allow read: if owner() || member();
        allow write: if owner();
      }
      match /qsets/{id} {
        allow read: if owner() || member();
        allow write: if owner();
      }
      match /subs/{uid} {
        // a learner may change only one piece of work at a time, and never the teacher's marks (mod)
        function workBefore() { return resource == null ? {} : resource.data.get('work', {}); }
        function workAfter() { return request.resource.data.get('work', {}); }
        function modOf(w, k) { return (k in w) && w[k] is map ? w[k].get('mod', null) : null; }
        // the app labels each learner write with the assignment it changes (_k)
        function learnerEdit() {
          let keys = workAfter().diff(workBefore()).affectedKeys();
          let k = request.resource.data.get('_k', '');
          return keys.size() == 0 || (keys.size() == 1 && keys.hasOnly([k]) && modOf(workAfter(), k) == modOf(workBefore(), k));
        }
        allow read: if owner() || isMe(uid);
        allow delete: if owner();
        allow create, update: if owner() || (isMe(uid) && member() && learnerEdit());
      }
    }
  }
}
