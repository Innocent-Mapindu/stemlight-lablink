{
  "name": "stemlight-lablink",
  "version": "1.0.0",
  "private": true,
  "description": "STEMLight LabLink: virtual science labs for every Zimbabwean learner",
  "scripts": {
    "serve": "npx --yes http-server app -p 8080 -c-1",
    "android": "npx cap sync android && npx cap open android",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lablink \"node tests/rules.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.29.1"
  }
}
